# Copy to .env and fill in. Everything has a default; the app runs with no keys at all
# (rules-based routing, extractive answers) so you can try it before signing up anywhere.

# --- Free LLM: https://console.groq.com/keys -------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b          # answers
GROQ_FAST_MODEL=openai/gpt-oss-20b      # query understanding (cheaper on rate limits)

# --- Optional: chart reading + Gemini embeddings: https://aistudio.google.com/apikey ----
GOOGLE_API_KEY=
VISION_MODEL=gemini-flash-lite-latest
VISION_MAX_PAGES=12                     # chart pages described per visual document

# --- Embeddings / reranker (local, free; models download once, ~150 MB) ----------------
EMBEDDINGS_PROVIDER=fastembed           # fastembed | gemini | hash (offline, not semantic)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK=1
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Vector DB ---------------------------------------------------------------------------
# Empty = embedded Qdrant in data/qdrant (one process at a time).
# Set to run several processes (web server + management commands) against one store:
#   docker run -p 6333:6333 qdrant/qdrant   then   QDRANT_URL=http://localhost:6333
QDRANT_URL=

# --- Retrieval ---------------------------------------------------------------------------
TOP_K=5
RETRIEVAL_POOL=30
RRF_K=60
MAX_CONTEXT_TOKENS=3500
BUILD_NAIVE_BASELINE=1                  # also index the basic-RAG baseline for Compare/Evaluate

# --- Django ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# FOLIO_DATA_DIR=./data
